# Server
NODE_ENV=development
PORT=5000
# CORS allowlist (exact browser origins). Production MUST use your live site URLs,
# e.g. https://mydukepetsolution.com — www/non-www variants are auto-added.
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Optional comma-separated extras (staging, preview domains, etc.)
# ALLOWED_ORIGINS=https://staging.mydukepetsolution.com

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/pets_marketplace

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Admin seed credentials (used by npm run seed)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@petnest.com
ADMIN_PASSWORD=Admin@12345

# Contact info (used to seed / expose site settings)
WHATSAPP_NUMBER=919999999999
PHONE_NUMBER=+919999999999

# Google Sheets live sync (optional)
# See server/scripts/google-sheets-appscript.gs
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
GOOGLE_SHEETS_URL=

# Hostinger SMTP (required for OTP and transactional email)
# Port is hardcoded to 465 (SSL/TLS) in code — SMTP_PORT in .env is ignored.
SMTP_HOST=smtp.hostinger.com
SMTP_USER=noreply@mydukepetsolution.com
SMTP_PASSWORD='your-mailbox-password'
SMTP_FROM=My Duke <noreply@mydukepetsolution.com>

# MSG91 OTP Widget (phone SMS)
# Auth key from MSG91 dashboard — used only on the server to verify widget JWT
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=36677a716230393038343036

# Resend is not used — all email goes through SMTP above.
# RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=admin@mydukepetsolution.com
SITE_NAME=My Duke
